# ---------------------------------------------------------------------------
# AgentStrike — environment variables (copy to .env and fill in values)
# ---------------------------------------------------------------------------

# Anthropic credentials
ANTHROPIC_API_KEY=sk-ant-...

# Model selection (override defaults if needed)
AGENTSTRIKE_RED_MODEL=claude-haiku-4-5
AGENTSTRIKE_BLUE_MODEL=claude-opus-4-6
AGENTSTRIKE_JUDGE_MODEL=claude-sonnet-4-6

# Orchestrator
AGENTSTRIKE_SESSION_SECRET=replace-with-a-long-random-string
AGENTSTRIKE_MAX_TURNS=20

# API server
AGENTSTRIKE_HOST=127.0.0.1
AGENTSTRIKE_PORT=8000

# Storage
AGENTSTRIKE_MEMORY_DIR=./memory_store
AGENTSTRIKE_EVENT_LOG_DIR=./event_logs
AGENTSTRIKE_REPORT_DIR=./reports

# Quorum / consensus
AGENTSTRIKE_QUORUM_SIZE=2

# Logging
AGENTSTRIKE_LOG_LEVEL=INFO
